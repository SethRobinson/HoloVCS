# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch
*.ipch

# Compiled Dynamic libraries
*.so
*.dylib


# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
Build/*
dist/*
HoloVCS/*
Build/bin
!Build/*/PakBlacklist*.txt
Plugins/*

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

Source/HoloVCS/SynthComponentSethHack.cpp
Source/HoloVCS/SynthComponentSethHack.h
Source/HoloVCS/SynthComponentSethHack.zip
HoloVCS_Win64.zip
*.a26
*.sav0
*.nes
*.vb
*.vboy

# Per-machine secrets (Android signing etc.)
Config/UserEngine.ini

# Commercial fonts can't be redistributed (Frutiger is a Monotype typeface)
Media/*.otf
Media/*.ttf

# Salvaged prebuilt emulator core DLLs (also recoverable from git history)
prebuilt_cores/

# Emulator core build outputs (BuildCores.bat)
cores/_built/
cores/**/x64/
cores/**/Release/
cores/**/Debug/
cores/**/.vs/
*.vcxproj.user
